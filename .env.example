COMPOSE_PROJECT_NAME=safe
SECRET_KEY=please-generate-with-openssl-rand-hex-32
APP_IMAGE=safe-app:local
PYTHON_IMAGE=python:3.11-slim
NGINX_IMAGE=nginx:1.27-alpine
DOMAIN=localhost
SESSION_TTL=28800
FAIL_WINDOW=600
MAX_FAILS=3
SETUP_FIREWALL=0
SETUP_FAIL2BAN=0

# Docker Hub 不可达时可选：让 init_server.sh 写入 daemon.json 镜像加速
SETUP_DOCKER_MIRROR=0
# 逗号分隔；按你所在网络可用的镜像站替换
DOCKER_REGISTRY_MIRRORS=https://docker.m.daocloud.io,https://dockerproxy.net
